(rule
 (targets kernels.ml)
 (action
  (with-stdout-to
   kernels.ml
   (run ../gen/gen_kernel.exe))))

(library
 (name octez_vanity)
 (libraries
  sarek
  sarek.core
  sarek.stdlib
  sarek.native
  spoc.framework
  sarek-cuda.plugin
  sarek-hip.plugin
  digestif
  zarith
  unix)
 (preprocess
  (pps sarek.ppx))
 (flags
  (:standard -w -33)))

; Generated field-arithmetic kernels, one module per prime field
; (gen/gen_field.ml).

(rule
 (targets field_ed25519.ml)
 (action
  (with-stdout-to
   field_ed25519.ml
   (run ../gen/gen_field.exe ed25519))))

(rule
 (targets field_secp256k1.ml)
 (action
  (with-stdout-to
   field_secp256k1.ml
   (run ../gen/gen_field.exe secp256k1))))

(rule
 (targets field_p256.ml)
 (action
  (with-stdout-to
   field_p256.ml
   (run ../gen/gen_field.exe p256))))

(rule
 (targets field_bls12_381.ml)
 (action
  (with-stdout-to
   field_bls12_381.ml
   (run ../gen/gen_field.exe bls12_381))))

; Walk kernel of the address search (gen/gen_walk.ml).

(rule
 (targets walk_secp256k1.ml)
 (action
  (with-stdout-to
   walk_secp256k1.ml
   (run ../gen/gen_walk.exe secp256k1))))

(rule
 (targets walk_p256.ml)
 (action
  (with-stdout-to
   walk_p256.ml
   (run ../gen/gen_walk.exe p256))))

(rule
 (targets walk_bls12_381.ml)
 (action
  (with-stdout-to
   walk_bls12_381.ml
   (run ../gen/gen_walk.exe bls12_381))))

; Seed-search kernel of the tz1 address search (gen/gen_ed25519.ml); the
; window width must be Seed_table.window_bits.

(rule
 (targets seed_ed25519.ml)
 (action
  (with-stdout-to
   seed_ed25519.ml
   (run ../gen/gen_ed25519.exe search 8))))
